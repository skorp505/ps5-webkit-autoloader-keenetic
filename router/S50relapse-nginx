#!/bin/sh
# Запуск встроенного в KeeneticOS nginx с конфигом Relapse.
# Подхватывается rc.unslung при загрузке роутера (Entware).
#
# usage: S50relapse-nginx {start|stop|restart|status}

PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin

NGINX=/usr/sbin/nginx
CONF=/storage/www/relapse-nginx.conf
PIDFILE=/tmp/relapse-nginx/nginx.pid
RUNDIR=/tmp/relapse-nginx

start() {
    mkdir -p "$RUNDIR"
    if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ]; then
        echo "relapse nginx already running"
        return 0
    fi
    [ -f "$CONF" ] || { echo "no config: $CONF"; return 1; }
    $NGINX -t -c "$CONF" >/dev/null 2>&1 || { echo "bad config: $CONF"; return 1; }
    $NGINX -c "$CONF"
}

stop() {
    if [ -f "$PIDFILE" ]; then
        $NGINX -c "$CONF" -s quit 2>/dev/null
        rm -f "$PIDFILE"
    fi
}

status() {
    if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ]; then
        echo "relapse nginx running (pid $(cat "$PIDFILE"))"
    else
        echo "relapse nginx stopped"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)
        echo "usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0