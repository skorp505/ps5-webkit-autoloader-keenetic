#!/bin/sh
# Запуск сторожа etaHEN: отправляет etaHEN на приставку сразу после того, как
# та поднимет allinOne. Не зависит от вебкита, в отличие от отправки со страницы.
#
# Подхватывается rc.unslung при загрузке роутера (Entware).
#
# usage: S60relapse-etahen {start|stop|restart|status}

PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin

WATCHER=/storage/www/relapse/auto-etahen.sh
PIDFILE=/tmp/relapse-etahen.pid
LOG=/tmp/relapse-etahen.log

# Адрес приставки: только в /storage/www/relapse/ps5.conf строкой PS5_IP=...
# Без конфига запускаться не станем — молча слать на чью-то сторону хуже,
# чем вовремя сказать, что адреса нет. Пишет его установщик, флаг --ps5-ip.
CONF=/storage/www/relapse/ps5.conf
PS5_IP=""

if [ -f "$CONF" ]; then
    # shellcheck source=/dev/null
    . "$CONF"
fi

start() {
    if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ]; then
        echo "auto-etahen already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    if [ -z "$PS5_IP" ]; then
        echo "нет адреса приставки: в $CONF должна быть строка PS5_IP=<адрес приставки>"
        echo "её пишет установщик, см. --ps5-ip"
        return 1
    fi
    [ -f "$WATCHER" ] || { echo "no watcher: $WATCHER"; return 1; }
    echo "starting auto-etahen for $PS5_IP"
    # На минимальном Entware нет ни setsid, ни nohup, поэтому перенаправляем
    # ввод из /dev/null и отсоединяемся через простой double-fork на скобках.
    # Скобки создают subshell, который не получает SIGHUP от вызывающего shell.
    (
        trap '' HUP
        "$WATCHER" "$PS5_IP" >>"$LOG" 2>&1 <"/dev/null" &
        echo $! >"$PIDFILE"
    )
    sleep 1
    [ -f "$PIDFILE" ] || { echo "не удалось запустить сторож, смотри $LOG"; return 1; }
    return 0
}

stop() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null && echo "stopped auto-etahen"
        rm -f "$PIDFILE"
    else
        echo "auto-etahen not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ]; then
        echo "auto-etahen running (pid $(cat "$PIDFILE")) for $PS5_IP"
    else
        echo "auto-etahen not running"
        return 1
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac